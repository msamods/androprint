<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC">

    <!-- Top Navigation Tabs (HUD vs Dashboard) -->
    <LinearLayout
        android:id="@+id/tabBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:background="#FFFFFF"
        android:padding="6dp"
        android:elevation="2dp"
        android:layout_alignParentTop="true">

        <Button
            android:id="@+id/btnTabHud"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="NATIVE HUD"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5" />

        <Button
            android:id="@+id/btnTabDashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="WEB DASHBOARD"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#475569"
            android:backgroundTint="#F1F5F9"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- NATIVE HUD VIEW -->
    <LinearLayout
        android:id="@+id/layoutHud"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tabBar"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal"
        android:visibility="visible">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:src="@drawable/app_logo"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="AndroPrint Logo"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AndroPrint v2.0"
            android:textColor="#0F172A"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Standalone ESC/POS Cloud &amp; LAN Gateway • No Termux"
            android:textColor="#0284C7"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_white_elevated"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvServerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Server Status: STOPPED"
                android:textColor="#DC2626"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvServerUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Local Endpoint: https://localhost:3000"
                android:textColor="#64748B"
                android:textSize="13sp"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvDeviceIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wi-Fi IP: Checking..."
                android:textColor="#4F46E5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Start/Stop Buttons -->
        <Button
            android:id="@+id/btnToggleServer"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="START PRINT SERVICE"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#059669"
            android:layout_marginTop="14dp" />

        <Button
            android:id="@+id/btnOpenDashboard"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="OPEN IN-APP DASHBOARD"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#4F46E5"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnCheckUpdate"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="CHECK FOR UPDATES (v2.0.1)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#0284C7"
            android:backgroundTint="#EEF2FF"
            android:layout_marginTop="8dp" />

        <!-- Console Log Terminal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Native Service Log Stream:"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="14dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/console_terminal_bg"
            android:padding="12dp"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/tvLogConsole"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="[AndroPrint Native Gateway Ready]\nTap 'START PRINT SERVICE' to launch embedded Node.js daemon...\n"
                android:textColor="#34D399"
                android:fontFamily="monospace"
                android:textSize="11sp" />
        </ScrollView>
    </LinearLayout>

    <!-- IN-APP FULLSCREEN WEBVIEW -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/tabBar"
        android:visibility="gone" />

</RelativeLayout>
