<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F0F23"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <!-- Header Logo & Branding -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🖨️"
        android:textSize="56sp"
        android:layout_marginTop="20dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="AndroPrint"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Developed By : MSA MODS x WhatYouWantKerala"
        android:textColor="#06B6D4"
        android:textSize="12sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp" />

    <!-- Status Badge Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#161637"
        android:padding="20dp"
        android:layout_marginTop="28dp">

        <TextView
            android:id="@+id/tvServerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Server Status: STOPPED"
            android:textColor="#EF4444"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvServerUrl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Endpoint: http://127.0.0.1:3000"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDeviceIp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wi-Fi IP: Checking..."
            android:textColor="#6366F1"
            android:textSize="13sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Control Buttons -->
    <Button
        android:id="@+id/btnToggleServer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="START PRINT SERVICE"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#10B981"
        android:layout_marginTop="28dp" />

    <Button
        android:id="@+id/btnOpenDashboard"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="OPEN WEB DASHBOARD"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:backgroundTint="#6366F1"
        android:layout_marginTop="12dp" />

    <!-- Server Log Terminal -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Console Activity Log:"
        android:textColor="#64748B"
        android:textSize="12sp"
        android:layout_marginTop="24dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0A18"
        android:padding="12dp"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/tvLogConsole"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[AndroPrint Native Agent Initialized]\nTap 'START PRINT SERVICE' to launch node daemon...\n"
            android:textColor="#10B981"
            android:fontFamily="monospace"
            android:textSize="11sp" />
    </ScrollView>

</LinearLayout>
