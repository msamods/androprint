{
  "name": "androprint",
  "version": "2.0.0",
  "description": "Next-Gen ESC/POS Cloud Print Server & Relay with Web Management Dashboard",
  "license": "SEE LICENSE IN LICENSE.md",
  "private": false,
  "main": "server.js",
  "bin": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "ssl": "node generate-ssl.js",
    "build:exe": "npx -y @yao-pkg/pkg . --targets node18-win-x64 --output dist/AndroPrint-Windows.exe --compress GZip"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jimp": "^1.6.1",
    "mqtt": "^5.16.1",
    "multer": "^1.4.5-lts.1",
    "node-thermal-printer": "^4.4.3",
    "pdf-parse": "^2.4.5",
    "qrcode": "^1.5.4",
    "sql.js": "1.10.3"
  }
}
